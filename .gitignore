# Unity Loom — ignore rules.
#
# The repository follows its own doctrine: the folders below are regenerated by
# Unity or by a tool, so they are never committed
# (doctrine/05-non-invasiveness.md section 4).
#
# Nothing here is a substitute for the validator. The validator proves the
# content of the tracked files; this file keeps the untracked noise out.

# ---------------------------------------------------------------- Unity output
# Generated by the Editor, regenerated on every open. Never hand-edited.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# The Unity asset database, the solution files the Editor generates, and the
# per-user project settings.
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Unity crash and profiling artefacts.
sysinfo.txt
crashlytics-build.properties
*.stackdump

# ---------------------------------------------------------------- IDE and OS
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# -------------------------------------------------------------------- Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ------------------------------------------------------------- Agent and tool
# Local agent state: session logs, caches, and the scratch state a harness
# writes next to the project it was pointed at.
.opencode/
.agents/
.claude/
.codex/
.cursor/
.gemini/
.grok/
.zcode/
.continue/
.aider*
.codeium/
.windsurf/
.copilot/
.factory/
.local/
.cache/

# The output directory of the release and performance jobs.
artifacts/
dist/
out/
build/
report/
coverage/
*.lcov

# Local environment and local overrides. The `.env.example` file is tracked.
.env
.env.*
!.env.example

# Editor and OS noise that can be generated anywhere in the tree.
*.log
*.tmp
*.bak
*.orig
*.rej
